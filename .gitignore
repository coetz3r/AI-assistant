# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual environments (keep your repo small)
.venv/
env/
venv/
ENV/

# Sensitive environment variables (CRITICAL: don't commit these!)
.env
.env.*
*.env

# IDE and editor specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store

# Operating system files
.DS_Store
Thumbs.db

# Distribution and build artifacts
build/
dist/
*.egg-info/
.eggs/

# Unit test and coverage reports
.pytest_cache/
.coverage
htmlcov/

# Log files
*.log

# Ignore local SSL certificates
*.pem
*.key
*.crt